    "node-cron": "^3.0.3",
    "ollama": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0"
}
