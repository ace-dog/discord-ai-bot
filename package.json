{
  "name": "discord-ai-bot",
  "version": "1.0.0",
  "description": "AI-powered Discord bot for jokes and conversation engagement",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node --watch dist/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["discord", "bot", "ai", "ollama", "typescript"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
